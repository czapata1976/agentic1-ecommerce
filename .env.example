# Copia este archivo a .env y rellena los valores reales.
# Nunca subas .env al repositorio ni escribas claves reales en el código.

# Clave de Google AI Studio (Gemini)
GOOGLE_API_KEY=

# Modelo de Gemini que usan los agentes
MODELO=gemini-3.5-flash-lite

# Token que entrega BotFather (vacío hasta el paso 5)
TELEGRAM_TOKEN=

# Secreto que Telegram envía en cada webhook para que la API lo verifique
TELEGRAM_SECRET=cambiame

# URL https pública del servicio (vacía hasta desplegar en Heroku)
PUBLIC_URL=
