meta {
  name: chat-preventa
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/chat
  body: json
  auth: none
}

body:json {
  {
    "user_id": "bruno-preventa",
    "texto": "¿tienen la polera azul en talla M?"
  }
}

tests {
  test("ruta preventa", function() {
    expect(res.status).to.equal(200);
    expect(res.body.ruta).to.equal("preventa");
    expect(res.body.motivo).to.be.a("string");
    expect(res.body.respuesta).to.be.a("string");
  });
}
