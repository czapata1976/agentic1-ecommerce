meta {
  name: chat-postventa
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/chat
  body: json
  auth: none
}

body:json {
  {
    "user_id": "bruno-postventa",
    "texto": "mi pedido 4521 llegó roto"
  }
}

tests {
  test("ruta postventa", function() {
    expect(res.status).to.equal(200);
    expect(res.body.ruta).to.equal("postventa");
    expect(res.body.motivo).to.be.a("string");
    expect(res.body.respuesta).to.be.a("string");
  });
}
