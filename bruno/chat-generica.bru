meta {
  name: chat-generica
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/chat
  body: json
  auth: none
}

body:json {
  {
    "user_id": "bruno-generica",
    "texto": "¿qué hora es en Tokio?"
  }
}

tests {
  test("ruta generica", function() {
    expect(res.status).to.equal(200);
    expect(res.body.ruta).to.equal("generica");
    expect(res.body.motivo).to.be.a("string");
    expect(res.body.respuesta).to.be.a("string");
  });
}
